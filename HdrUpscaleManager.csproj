<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>HdrUpscaleManager</AssemblyName>
    <RootNamespace>HdrUpscaleManager</RootNamespace>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Source of truth for the plugin version is extension.yaml (that's what Playnite's
         Add-ons UI reads). Kept in sync here so the DLL's AssemblyVersion / FileVersion
         match what shows up in Playnite's extension logs on load. Bump both together. -->
    <Version>0.3.3</Version>
    <AssemblyVersion>0.3.3.0</AssemblyVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <InformationalVersion>0.3.3</InformationalVersion>

    <!-- Security guard: promote NuGet vulnerability warnings (moderate/high/critical)
         to errors so we can't ship a build that pulls in a known-vulnerable package.
         NU1901=Low, NU1902=Moderate, NU1903=High, NU1904=Critical. Low kept as warning. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official SDK NuGet package published by the Playnite team -->
    <PackageReference Include="PlayniteSDK" Version="6.16.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <!-- Needed only for real 7z extraction (DXVK+Lilium, OptiScaler releases) — ReShade's
         disguised-zip payload didn't need this, but genuine LZMA/7z decoding isn't something
         to hand-roll. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assemblies not auto-referenced by SDK-style projects on net462. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship this next to the DLL so Playnite's Extensions folder is self-contained -->
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled verbatim from optiscaler/OptiScaler's OptiScaler.amd-dlss.ini (GPL-3.0, credited
         in THIRD_PARTY_NOTICES.md) — the AMD no-DLSS variant is derived from this at runtime by
         flipping the single [Spoofing] Dxgi= line, since the two upstream files are otherwise
         byte-identical. -->
    <EmbeddedResource Include="Resources\OptiScaler.ini.template">
      <LogicalName>HdrUpscaleManager.Resources.OptiScaler.ini.template</LogicalName>
    </EmbeddedResource>

    <!-- Snapshot of the repo-root luma_prerequisites.json (our own data, not a third-party
         redistribution) — used only as a last-resort fallback by LumaPrerequisitesManifestService
         when neither a live fetch nor a local disk cache is available yet. Keep in sync with the
         root copy by hand; it's a small, rarely-changing file. -->
    <EmbeddedResource Include="Resources\luma_prerequisites.json">
      <LogicalName>HdrUpscaleManager.Resources.luma_prerequisites.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Gamepad button glyphs for the Fullscreen manager window's "confirm/close" hint (see
         ManagerFullscreenView.xaml) — Kenney's Input Prompts pack (kenney.nl/assets/input-prompts),
         CC0/public domain, no attribution required. Style picked at runtime by
         GamepadIconStyleDetector; both sets are bundled since which one applies isn't known
         until a controller is actually connected. -->
    <Resource Include="Resources\GamepadIcons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- HdrUpscaleManager.Tests, HdrUpscaleManager.UiTests, GamepadPoc (a local-only, gitignored
         scratch project — see .git/info/exclude — for probing gamepad/UIA behavior, not part of
         the shipped addon), and reference\RHI (a gitignored local clone of upstream RankFTW/RHI
         kept for diffing — see .gitignore) all live in subfolders of this project's own
         directory. Without this, the default item globs below would try to pull their files into
         this project too — .cs test files (and xunit/FlaUI/Nefarius references), and for
         reference\RHI specifically, its WinUI 3 .xaml files get auto-included as WPF
         Page/ApplicationDefinition items and fail to parse (they use WinUI-only markup like
         XamlControlsResources/RequestedTheme that WPF's XAML compiler doesn't recognize). -->
    <Compile Remove="HdrUpscaleManager.Tests\**;HdrUpscaleManager.UiTests\**;GamepadPoc\**;reference\**" />
    <EmbeddedResource Remove="HdrUpscaleManager.Tests\**;HdrUpscaleManager.UiTests\**;GamepadPoc\**;reference\**" />
    <None Remove="HdrUpscaleManager.Tests\**;HdrUpscaleManager.UiTests\**;GamepadPoc\**;reference\**" />
    <Page Remove="reference\**" />
    <ApplicationDefinition Remove="reference\**" />
    <Resource Remove="reference\**" />
  </ItemGroup>

</Project>
